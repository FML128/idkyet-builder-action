{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "idkyet updater",
      "customType": "regex",
      "fileMatch": [
        "^.+\\.ya?ml$"
      ],
      "matchStrings": [
        "previous_layer: (?<depName>[^:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Digest-pinned secure builder image in workflow env (BUILDER / BUILDER_IMAGE); consumers cosign-verify it before use",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.forgejo/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>git\\.fml128\\.ch/fml128/idkyet-builder-secure):(?<currentValue>[0-9]+(?:\\.[0-9]+)+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "regex"
      ],
      "automerge": true
    }
  ]
}
